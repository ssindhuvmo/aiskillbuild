ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-5
# YouTube Data API v3 key (Google Cloud Console > APIs & Services > Credentials; enable
# "YouTube Data API v3"). Leave empty to skip the YouTube source.
YOUTUBE_API_KEY=
# Job Match searches only these sites (comma-separated; subdomains are included). Leave commented
# out for the default list. Indeed often blocks automated link checks, so its links show "not checked".
# JOB_SITES=boards.greenhouse.io,jobs.lever.co,jobs.ashbyhq.com,apply.workable.com,wellfound.com,indeed.com
DATABASE_URL=sqlite:///./career_strategist.db
FRONTEND_ORIGIN=http://localhost:5173
# Where the course search graph keeps each user's paused refinement chat (default:
# backend/graph_checkpoints.db).
# CHECKPOINT_DB=./graph_checkpoints.db
# Where uploaded resumes are stored, one folder per user (default: backend/uploads).
# UPLOAD_DIR=./uploads

# Google sign-in: the OAuth 2.0 Web client ID from Google Cloud Console (same value as
# VITE_GOOGLE_CLIENT_ID in frontend/.env).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me
# Secure (HTTPS-only) session cookie. Chrome/Firefox accept it on http://localhost;
# set to false only if your browser drops the cookie in local dev.
SESSION_COOKIE_SECURE=true
